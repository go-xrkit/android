  The XR capture host. Two components and no more: a foreground service that
  owns the MediaProjection, and a transparent Activity that holds the consent
  dialog. Neither owns a drawing surface — in a real application that belongs to
  go-widgets/android's Activity, and there can only be one.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          package="org.goxrkit.androidhost">

    <!-- A mediaProjection foreground service is MANDATORY from API 34: the
         platform refuses the projection token to a process that is not already
         running one. FOREGROUND_SERVICE_MEDIA_PROJECTION is protectionLevel
         normal, so an ordinary APK may simply declare it. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- The service must show a notification, and from API 33 that is a
         runtime permission. A refusal does not stop the capture. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- GW_PERMISSIONS -->

    <!-- ⚠ DECLARED, NOT REQUIRED. A headset's camera is a USB device, and
         whether this application can reach it is a per-device measurement: the
         UsbManager census in XrWallService needs no permission, but a phone
         with no USB host support at all has no UsbManager to ask. Marking it
         required="true" would hide this APK from every such device in the
         store, including ones where everything else here works. -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <!-- ⛔ DEBUGGABLE, BECAUSE AN ARTEFACT NOBODY CAN READ IS NOT AN ARTEFACT.
         The commands here write their verdict to the app's external files
         directory so that it survives a run nobody could watch: the phone has
         ONE USB-C port, and attaching the glasses takes the cable adb was
         using. Modern Android hides /storage/emulated/0/Android/data/<pkg>/
         from the shell user, and `adb shell run-as` is refused outright for a
         package that is not debuggable -

             run-as: package not debuggable: org.goxrkit.androidhost

         so a whole run was measured, written down, and unreadable, with the
         logcat ring buffer long since rotated. This is a diagnostic host that
         exists to be read from a cable; it is not shipped to anybody. -->
    <application android:label="go-xrkit" android:hasCode="true"
                 android:debuggable="true">
        <activity android:name="org.goxrkit.android.XrDemoActivity"
                  android:exported="true"
                  android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation|uiMode">
            <meta-data android:name="org.goxrkit.args" android:value="" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- ⛔ THE ATTACH ROUTE. UsbManager.requestPermission answers NOT
                 GRANTED in twenty milliseconds and shows no dialog on Android 17
                 - watched on the screen, not only in a log. A device named in
                 device_filter.xml makes the system OFFER this application when
                 it is attached, and accepting grants the permission
                 persistently. ⚠ It costs a REPLUG: a headset already plugged in
                 when the APK was installed produces no offer until it is
                 unplugged and plugged back. -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                       android:resource="@xml/device_filter" />
        </activity>

        <!-- The display probe. Not a launcher activity: it is started by hand
             with `am start` and reports to logcat. It exists so the answers in
             the README are the platform's own words rather than a reading of
             the documentation. -->
        <activity android:name="org.goxrkit.android.XrDisplayProbeActivity"
                  android:exported="true"
                  android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation|uiMode" />

        <!-- ⛔ NOT EXPORTED. It opens the USB device it is told to, so an
             exported one would let any application drive this one into asking
             for a device of their choosing under our name. -->
        <activity android:name="org.goxrkit.android.XrUsbPermissionActivity"
                  android:exported="false"
                  android:excludeFromRecents="true"
                  android:noHistory="true"
                  android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <activity android:name="org.goxrkit.android.XrConsentActivity"
                  android:exported="false"
                  android:excludeFromRecents="true"
                  android:noHistory="true"
                  android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- The wall host: displays this app creates and owns. It asks for NO
             permission, needs no consent and is not a foreground service —
             an owned display needs none of what a MediaProjection needs. -->
        <service android:name="org.goxrkit.android.XrWallService"
                 android:exported="false" />

        <service android:name="org.goxrkit.android.XrHostService"
                 android:exported="false"
                 android:foregroundServiceType="mediaProjection" />
    </application>
</manifest>
